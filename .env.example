# ==============================================================================
# Movie Streaming ELT Pipeline Environment Configuration
# ==============================================================================

# Google Cloud Platform / BigQuery Configuration
BIGQUERY_PROJECT=your-gcp-project-id
BIGQUERY_LOCATION=US
BIGQUERY_DATASET_RAW=raw_movies
BIGQUERY_DATASET_ANALYTICS=analytics_movies

# Google Cloud Service Account Credentials
# Absolute or relative path to your service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Apache Airflow Settings
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# Airbyte Connection Parameters
# Used by Airflow to communicate with your local or cloud Airbyte instance
AIRBYTE_HOST=host.docker.internal
AIRBYTE_PORT=8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password
# Connection ID from your Airbyte UI (URL: /workspaces/<id>/connections/<connection_id>)
AIRBYTE_CONNECTION_ID=your_airbyte_connection_id_here

# External APIs
# The Movie Database (TMDB) API Key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API Key for Streamlit Conversational BI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

